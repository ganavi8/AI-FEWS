# Copy to .env only for local development. Never commit populated environment files.
# Production must receive these values from the platform's protected environment settings.

# Durable managed MySQL. User data and schema are shared by preview and production.
DATABASE_URL=

# Server-only secret used to protect verified community-report moderation.
MODERATION_TOKEN=

# Public policy/support details returned by the public-config endpoint.
# Keep genuine operator details in protected settings, not in source or a client bundle.
PUBLIC_SUPPORT_CONTACT=
PUBLIC_OPERATOR_NAME=
PUBLIC_OPERATOR_ADDRESS=

# Runtime listener and mode. The Webdev container provides PORT at runtime.
PORT=3000
NODE_ENV=development

# Optional endpoint overrides; default public endpoints require no API key.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
