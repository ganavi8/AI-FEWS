{
  "name": "aifews",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "vite build && node scripts/generate-sw.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:android": "AIFEWS_NATIVE_BUILD=1 vite build",
    "build": "pnpm typecheck && pnpm test && pnpm build:web && pnpm build:server",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "verify:providers": "tsx scripts/check-live-providers.ts",
    "android:sync": "pnpm build:android && cap sync android",
    "android:bundle": "pnpm android:sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
